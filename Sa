local httpService = game:GetService('HttpService')

local SaveManager = {} do
	SaveManager.Folder = 'LinoriaLibSettings'
	SaveManager.Ignore = {}
	SaveManager.Parser = {
		Toggle = {
			Save = function(idx, object) 
				return { type = 'Toggle', idx = idx, value = object.Value } 
			end,
			Load = function(idx, data)
				if Toggles[idx] and data.value ~= nil then
					Toggles[idx]:SetValue(data.value)
				end
			end,
		},
		Slider = {
			Save = function(idx, object)
				return { type = 'Slider', idx = idx, value = tostring(object.Value) }
			end,
			Load = function(idx, data)
				if Options[idx] and data.value then
					local numValue = tonumber(data.value)
					if numValue then
						Options[idx]:SetValue(numValue)
					end
				end
			end,
		},
		Dropdown = {
			Save = function(idx, object)
				return { type = 'Dropdown', idx = idx, value = object.Value, multi = object.Multi }
			end,
			Load = function(idx, data)
				if Options[idx] and data.value ~= nil then
					Options[idx]:SetValue(data.value)
				end
			end,
		},
		ColorPicker = {
			Save = function(idx, object)
				return { type = 'ColorPicker', idx = idx, value = object.Value:ToHex(), transparency = object.Transparency }
			end,
			Load = function(idx, data)
				if Options[idx] and data.value and data.transparency ~= nil then
					local success, color = pcall(Color3.fromHex, data.value)
					if success then
						Options[idx]:SetValueRGB(color, data.transparency)
					end
				end
			end,
		},
		KeyPicker = {
			Save = function(idx, object)
				return { type = 'KeyPicker', idx = idx, mode = object.Mode, key = object.Value }
			end,
			Load = function(idx, data)
				if Options[idx] and data.key ~= nil and data.mode ~= nil then
					Options[idx]:SetValue({ data.key, data.mode })
				end
			end,
		},

		Input = {
			Save = function(idx, object)
				return { type = 'Input', idx = idx, text = object.Value }
			end,
			Load = function(idx, data)
				if Options[idx] and type(data.text) == 'string' then
					Options[idx]:SetValue(data.text)
				end
			end,
		},
	}

	function SaveManager:SetIgnoreIndexes(list)
		for _, key in next, list do
			self.Ignore[key] = true
		end
	end

	function SaveManager:SetFolder(folder)
		self.Folder = folder;
		self:BuildFolderTree()
	end

	function SaveManager:ValidateConfigName(name)
		if not name or type(name) ~= 'string' then
			return false, 'config name must be a non-empty string'
		end

		local trimmed = name:gsub('^%s+', ''):gsub('%s+$', '')
		if trimmed == '' then
			return false, 'config name cannot be empty'
		end

		if name:match('[<>:"|%?%*\\/]') then
			return false, 'config name contains invalid characters'
		end

		return true, trimmed
	end

	function SaveManager:Save(name)
		local valid, result = self:ValidateConfigName(name)
		if not valid then
			return false, result
		end
		name = result

		local fullPath = self.Folder .. '/settings/' .. name .. '.json'

		local data = {
			objects = {}
		}

		Toggles = Toggles or {}
		Options = Options or {}

		for idx, toggle in next, Toggles do
			if not self.Ignore[idx] and toggle and toggle.Type and self.Parser[toggle.Type] then
				local success, saved = pcall(self.Parser[toggle.Type].Save, idx, toggle)
				if success and saved then
					table.insert(data.objects, saved)
				end
			end
		end

		for idx, option in next, Options do
			if self.Parser[option.Type] and not self.Ignore[idx] then
				local success, saved = pcall(self.Parser[option.Type].Save, idx, option)
				if success and saved then
					table.insert(data.objects, saved)
				end
			end
		end	

		local success, encoded = pcall(httpService.JSONEncode, httpService, data)
		if not success then
			return false, 'failed to encode data'
		end

		writefile(fullPath, encoded)
		return true
	end

	function SaveManager:Load(name)
		if (not name or type(name) ~= 'string' or name:gsub(' ', '') == '') then
			return false, 'no config file is selected'
		end
		
		local file = self.Folder .. '/settings/' .. name .. '.json'
		if not isfile(file) then 
			return false, 'config file does not exist: ' .. name
		end

		local fileContent = readfile(file)
		if not fileContent or fileContent == '' then
			return false, 'config file is empty'
		end

		local success, decoded = pcall(httpService.JSONDecode, httpService, fileContent)
		if not success then 
			return false, 'failed to decode config file (invalid JSON)'
		end

		if not decoded or not decoded.objects or type(decoded.objects) ~= 'table' then
			return false, 'invalid config file format'
		end

		Options = Options or {}
		Toggles = Toggles or {}

		local islandSelectionValue = nil
		for _, option in next, decoded.objects do
			if option and option.type and option.idx and self.Parser[option.type] then
				if option.idx == 'IslandSelection' and option.value then
					islandSelectionValue = option.value
				end
				task.spawn(function() 
					pcall(function()
						self.Parser[option.type].Load(option.idx, option)
					end)
				end)
			end
		end

		if islandSelectionValue and self.OnConfigLoad then
			task.spawn(function()
				task.wait(0.5)
				self.OnConfigLoad(islandSelectionValue)
			end)
		end

		return true
	end

	function SaveManager:IgnoreThemeSettings()
		self:SetIgnoreIndexes({ 
			"BackgroundColor", "MainColor", "AccentColor", "OutlineColor", "FontColor",
			"ThemeManager_ThemeList", 'ThemeManager_CustomThemeList', 'ThemeManager_CustomThemeName',
		})
	end

	function SaveManager:BuildFolderTree()
		local paths = {
			self.Folder,
			self.Folder .. '/themes',
			self.Folder .. '/settings'
		}

		for i = 1, #paths do
			local str = paths[i]
			if not isfolder(str) then
				makefolder(str)
			end
		end
	end

	function SaveManager:RefreshConfigList()
		local settingsFolder = self.Folder .. '/settings'
		if not isfolder(settingsFolder) then
			return {}
		end

		local list = listfiles(settingsFolder)
		local out = {}

		for i = 1, #list do
			local file = list[i]
			if file:match('%.json$') then
				local filename = file:match('([^/\\]+)%.json$')
				if filename and filename ~= '' then
					table.insert(out, filename)
				end
			end
		end

		table.sort(out)
		return out
	end

	function SaveManager:SetLibrary(library)
		self.Library = library
	end

	function SaveManager:LoadAutoloadConfig()
		if not self.Library then
			return false, 'Library not set'
		end

		local autoloadFile = self.Folder .. '/settings/autoload.txt'
		if not isfile(autoloadFile) then
			return false, 'no autoload config set'
		end

		local name = readfile(autoloadFile)
		if not name then
			return false, 'autoload config name is empty'
		end

		name = name:gsub('^%s+', ''):gsub('%s+$', ''):gsub('\r', ''):gsub('\n', '')
		if name == '' then
			return false, 'autoload config name is empty'
		end

		local success, err = self:Load(name)
		if not success then
			if self.Library then
				self.Library:Notify('Failed to load autoload config: ' .. err, 3)
			end
			return false, err
		end

		if self.Library then
			self.Library:Notify(string.format('Auto loaded config %q', name))
		end
		return true
	end


	function SaveManager:UpdateAutoloadLabel()
		if not self.AutoloadLabel then return end

		local autoloadFile = self.Folder .. '/settings/autoload.txt'
		if isfile(autoloadFile) then
			local name = readfile(autoloadFile)
			if name then
				name = name:gsub('^%s+', ''):gsub('%s+$', ''):gsub('\r', ''):gsub('\n', '')
				if name ~= '' then
					self.AutoloadLabel:SetText('Current autoload config: ' .. name)
					return
				end
			end
		end
		self.AutoloadLabel:SetText('Current autoload config: none')
	end

	function SaveManager:DeleteConfig(name)
		if not name or type(name) ~= 'string' or name:gsub(' ', '') == '' then
			return false, 'invalid config name'
		end

		local file = self.Folder .. '/settings/' .. name .. '.json'
		if not isfile(file) then
			return false, 'config file does not exist'
		end

		delfile(file)
		return true
	end

	function SaveManager:BuildConfigSection(tab)
		assert(self.Library, 'Must set SaveManager.Library')

		local section = tab:AddRightGroupbox('Configuration')

		section:AddInput('SaveManager_ConfigName',    { Text = 'Config name' })
		section:AddDropdown('SaveManager_ConfigList', { Text = 'Config list', Values = self:RefreshConfigList(), AllowNull = true })

		section:AddDivider()

		section:AddButton('Create config', function()
			local name = Options.SaveManager_ConfigName.Value

			local valid, result = self:ValidateConfigName(name)
			if not valid then
				return self.Library:Notify(result, 2)
			end

			local success, err = self:Save(result)
			if not success then
				return self.Library:Notify('Failed to save config: ' .. err, 2)
			end

			self.Library:Notify(string.format('Created config %q', result))

			Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())
			Options.SaveManager_ConfigName:SetValue('')
		end):AddButton('Load config', function()
			local name = Options.SaveManager_ConfigList.Value

			if not name then
				return self.Library:Notify('Please select a config to load', 2)
			end

			local success, err = self:Load(name)
			if not success then
				return self.Library:Notify('Failed to load config: ' .. err, 2)
			end

			self.Library:Notify(string.format('Loaded config %q', name))
		end)

		section:AddButton('Overwrite config', function()
			local name = Options.SaveManager_ConfigList.Value

			if not name then
				return self.Library:Notify('Please select a config to overwrite', 2)
			end

			local success, err = self:Save(name)
			if not success then
				return self.Library:Notify('Failed to overwrite config: ' .. err, 2)
			end

			self.Library:Notify(string.format('Overwrote config %q', name))
		end):AddButton('Delete config', function()
			local name = Options.SaveManager_ConfigList.Value

			if not name then
				return self.Library:Notify('Please select a config to delete', 2)
			end

			local success, err = self:DeleteConfig(name)
			if not success then
				return self.Library:Notify('Failed to delete config: ' .. err, 2)
			end

			self.Library:Notify(string.format('Deleted config %q', name))

			Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())
			Options.SaveManager_ConfigList:SetValue(nil)
			self:UpdateAutoloadLabel()
		end)

		section:AddButton('Refresh list', function()
			Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())
			Options.SaveManager_ConfigList:SetValue(nil)
			self:UpdateAutoloadLabel()
		end)

		section:AddButton('Set as autoload', function()
			local name = Options.SaveManager_ConfigList.Value

			if not name then
				return self.Library:Notify('Please select a config to set as autoload', 2)
			end

			local file = self.Folder .. '/settings/' .. name .. '.json'
			if not isfile(file) then
				return self.Library:Notify('Config file does not exist', 2)
			end

			writefile(self.Folder .. '/settings/autoload.txt', name)
			self:UpdateAutoloadLabel()
			self.Library:Notify(string.format('Set %q to auto load', name))
		end):AddButton('Clear autoload', function()
			local autoloadFile = self.Folder .. '/settings/autoload.txt'
			if isfile(autoloadFile) then
				delfile(autoloadFile)
			end
			self:UpdateAutoloadLabel()
			self.Library:Notify('Cleared autoload config')
		end)

		self.AutoloadLabel = section:AddLabel('Current autoload config: none', true)
		self:UpdateAutoloadLabel()

		self:SetIgnoreIndexes({ 'SaveManager_ConfigList', 'SaveManager_ConfigName' })

		task.spawn(function()
			task.wait(0.1)
			self:LoadAutoloadConfig()
		end)
	end

	SaveManager:BuildFolderTree()
end

return SaveManager
